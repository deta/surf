# Acosta Browse build configuration.
# Copy to .env and fill in real values. M_VITE_* vars are injected into the
# main process at build time (see electron.vite.config.ts).

# --- Firebase (Acosta AI project) ---
M_VITE_FIREBASE_API_KEY=
M_VITE_FIREBASE_AUTH_DOMAIN=acosta-ai.firebaseapp.com

# OAuth client id for the Google Sign-In popup flow (Web client type)
M_VITE_GOOGLE_OAUTH_CLIENT_ID=

# --- Acosta API ---
# Override for staging; defaults to https://api.acosta.ai
M_VITE_ACOSTA_API_URL=

# --- Updates ---
# Defaults to https://updates.acosta-ai.com
M_VITE_APP_UPDATES_PROXY_URL=
M_VITE_DISABLE_AUTO_UPDATE=false

# --- Development ---
# Skip the login wall while developing without a Firebase project.
# Never enable in production builds.
M_VITE_ACOSTA_DEV_BYPASS_AUTH=false
